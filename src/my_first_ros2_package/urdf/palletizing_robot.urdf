<?xml version="1.0"?>

<robot name="palletizing_robot">

  <!-- ================================================================ -->
  <!-- WORLD / FIXED FOUNDATION                                         -->
  <!-- ================================================================ -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- ROBOT BASE                                                       -->
  <!-- ================================================================ -->

  <link name="base_link">

    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.3"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia
        ixx="0.466667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.466667"
        iyz="0.0"
        izz="0.900000"/>
    </inertial>

  </link>


  <!-- ================================================================ -->
  <!-- BASE -> TORSO                                                    -->
  <!-- ================================================================ -->

  <joint name="base_to_torso" type="continuous">

    <parent link="base_link"/>
    <child link="torso_link"/>

    <origin xyz="0 0 0.05" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ================================================================ -->
  <!-- TORSO                                                            -->
  <!-- ================================================================ -->

  <link name="torso_link">

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>

      <geometry>
        <cylinder length="0.5" radius="0.15"/>
      </geometry>

      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>

      <geometry>
        <cylinder length="0.5" radius="0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>

      <mass value="10.0"/>

      <inertia
        ixx="0.264583"
        ixy="0.0"
        ixz="0.0"
        iyy="0.264583"
        iyz="0.0"
        izz="0.112500"/>
    </inertial>

  </link>


  <!-- ================================================================ -->
  <!-- TORSO -> ARM                                                     -->
  <!-- ================================================================ -->

  <joint name="torso_to_arm" type="revolute">

    <parent link="torso_link"/>
    <child link="arm_link"/>

    <origin xyz="0 0 0.5" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="50.0"
      velocity="1.0"/>

  </joint>


  <!-- ================================================================ -->
  <!-- ARM                                                              -->
  <!-- ================================================================ -->

  <link name="arm_link">

    <visual>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>

      <geometry>
        <box size="0.1 0.1 0.8"/>
      </geometry>

      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>

      <geometry>
        <box size="0.1 0.1 0.8"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>

      <mass value="5.0"/>

      <inertia
        ixx="0.270833"
        ixy="0.0"
        ixz="0.0"
        iyy="0.270833"
        iyz="0.0"
        izz="0.008333"/>
    </inertial>

  </link>


  <!-- ================================================================ -->
  <!-- ARM -> GRIPPER                                                   -->
  <!-- ================================================================ -->

  <joint name="arm_to_gripper" type="fixed">

    <parent link="arm_link"/>
    <child link="gripper_link"/>

    <origin xyz="0 0 0.8" rpy="0 0 0"/>

  </joint>


  <!-- ================================================================ -->
  <!-- GRIPPER                                                          -->
  <!-- ================================================================ -->

  <link name="gripper_link">

    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>

      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>

      <material name="gold">
        <color rgba="0.8 0.6 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>

      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.003542"
        ixy="0.0"
        ixz="0.0"
        iyy="0.003542"
        iyz="0.0"
        izz="0.006667"/>
    </inertial>

  </link>


  <!-- ================================================================ -->
  <!-- BASE -> CONVEYOR                                                 -->
  <!-- ================================================================ -->

  <joint name="base_to_conveyor" type="fixed">

    <parent link="base_link"/>
    <child link="conveyor_link"/>

    <origin xyz="0.8 0.0 0.4" rpy="0 0 0"/>

  </joint>


  <!-- ================================================================ -->
  <!-- CONVEYOR                                                         -->
  <!-- ================================================================ -->

  <link name="conveyor_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.4 1.5 0.05"/>
      </geometry>

      <material name="blue">
        <color rgba="0.0 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.4 1.5 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="15.0"/>

      <inertia
        ixx="2.815625"
        ixy="0.0"
        ixz="0.0"
        iyy="0.203125"
        iyz="0.0"
        izz="3.012500"/>
    </inertial>

  </link>


  <!-- ================================================================ -->
  <!-- ROS 2 CONTROL                                                    -->
  <!-- ================================================================ -->

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Base yaw -->
    <joint name="base_to_torso">

      <command_interface name="position"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <!-- Arm pitch -->
    <joint name="torso_to_arm">

      <command_interface name="position"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>

  </ros2_control>


  <!-- ================================================================ -->
  <!-- GAZEBO ROS 2 CONTROL PLUGIN                                      -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>/home/dtran/ros2_ws/src/my_first_ros2_package/config/controllers.yaml</parameters>

    </plugin>

  </gazebo>


</robot>